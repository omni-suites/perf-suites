{
  "name": "perf-suites",
  "version": "1.0.0",
  "description": "Domain-Driven k6 Performance Testing Framework for Omni-Suites",
  "main": "dist/main.js",
  "scripts": {
    "build": "webpack",
    "build:watch": "webpack --watch",
    "test": "k6 run dist/main.js",
    "test:checkout": "k6 run dist/checkout-flow.js",
    "test:order": "k6 run dist/create-order.load.js",
    "test:inventory": "k6 run dist/deduct-stock.load.js",
    "test:browser": "k6 run dist/hybrid-browser-checkout.js"
  },
  "devDependencies": {
    "@types/k6": "^0.50.0",
    "dotenv": "^18.0.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
